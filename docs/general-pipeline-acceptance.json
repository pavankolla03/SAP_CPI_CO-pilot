            "unitPrice": 100
          },
          {
            "id": "INV-2",
            "quantity": 10,
            "unitPrice": 600
          },
          {
            "id": "INV-1",
            "quantity": 8,
            "unitPrice": 900
          }
        ]
      },
      "output": {
        "invoices": [
          {
            "invoiceId": "INV-1",
            "quantity": 2,
            "unitPrice": 100,
            "total": 200,
            "status": "APPROVED"
          },
          {
            "invoiceId": "INV-2",
            "quantity": 10,
            "unitPrice": 600,
            "total": 6000,
            "status": "MANUAL_REVIEW"
          }
