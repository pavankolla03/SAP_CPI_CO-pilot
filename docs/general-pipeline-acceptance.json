            "operator": "multiply",
            "right_field": "unitPrice",
            "right_value": null
          }
        ],
        "filters": [],
        "routes": [
          {
            "condition": {
              "source": "total",
              "operator": "gt",
              "value": 5000
            },
            "label": "MANUAL_REVIEW"
          },
          {
            "condition": {
              "source": "total",
              "operator": "le",
              "value": 5000
            },
            "label": "APPROVED"
          }
        ],
        "default_route": "APPROVED",
        "status_field": "status",
        "deduplicate_by": "id",
        "sort_by": null,
        "sort_descending": false,
        "output_collection": "invoices",
