# Run scripts/init_demo.py for a random demo token. Never commit real tokens.
API_KEYS_JSON='{"replace-with-a-random-token-at-least-24-characters":{"tenant_id":"demo","actor":"developer@example.com","role":"approver"}}'
DATA_DIR=data
TENANTS_FILE=.tenants.json
# Optional, exact unpacked Chrome extension origin (no wildcard).
EXTENSION_ORIGIN=chrome-extension://YOUR_EXTENSION_ID
POLL_ATTEMPTS=6
POLL_SECONDS=2
# Server-only credentials, referenced by the SAP tenant configuration below.
SAP_DEV_CLIENT_ID=
SAP_DEV_CLIENT_SECRET=

# Optional goal-to-draft planning: zero-price :free models only.
LLM_ENABLED=false
LLM_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nex-agi/nex-n2.5-pro:free
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
APIM_CLIENT_ID=
APIM_CLIENT_SECRET=
AEM_API_TOKEN=

# Optional local voice; run scripts/setup_voice.py after installing the voice extra.
VOICE_ENABLED=false
VOICE_MODEL_PATH=data/voice-model
CHANNEL_WORKER_ENABLED=true
# WhatsApp remains disconnected until account setup and explicit recipient linking.
WHATSAPP_ENABLED=false
WHATSAPP_SEND_ENABLED=false
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_LINKS_JSON={}
